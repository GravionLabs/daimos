{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daimos",
  "version": "0.1.0",
  "identifier": "dev.gravionlabs.daimos",
  "build": {
    "frontendDist": "../apps/ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @daimos/ui dev",
    "beforeBuildCommand": "pnpm --filter @daimos/ui build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Daimos",
        "width": 720,
        "height": 120,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/icons/**", "$CACHE/daimos/icons/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
